# Sinch Voice API v2 credentials (from https://dashboard.sinch.com)
PROJECT_ID=your-projectid-here
KEY_ID=your-key-here
KEY_SECRET=your-secret-here

# Your Sinch virtual number (E.164 format, e.g. +14045001000)
SINCH_NUMBER=+1XXXXXXXXXX

# Destination phone number to call (E.164 format)
DESTINATION_NUMBER=+1XXXXXXXXXX

# The service whose call behavior the inbound/forwarding tutorials reconfigure.
# Find it via GET /v2/projects/{projectId}/services or in the dashboard.
SERVICE_ID=your-service-id-here

# Callback URL (your publicly accessible server, e.g. via ngrok)
CALLBACK_URL=https://your-ngrok-url.ngrok.io

# WebSocket endpoint URL (for 3.4.x streaming / relay tutorials)
WS_ENDPOINT=wss://your-ngrok-url.ngrok-free.app

# For recording (3.3.3): cloud storage destination (S3, GCS, or Azure)
STORAGE_DESTINATION_URL=s3://your-bucket/recordings/
STORAGE_CREDENTIALS=ACCESS_KEY:SECRET_KEY:REGION

# Hunting (3.1.3) — comma-separated agent E.164 list
AGENT_NUMBERS=+15551110001,+15551110002,+15551110003

# Batch pacing (3.1.2)
MAX_CPS=5
TTL_SECONDS=1800
RECIPIENTS=+15551110001,+15551110002,+15551110003

# Forwarding (3.2.2)
PRIMARY_NUMBER=+15557770001
FALLBACK_NUMBER=+15557770002
BUSINESS_START_HOUR_UTC=8
BUSINESS_END_HOUR_UTC=18

# AI IVR (3.4.5) — the two human-agent queues the relay can patch the call into
SALES_NUMBER=+15558880001
SUPPORT_NUMBER=+15558880002

# AI IVR (3.4.5) — model-agnostic LLM, any OpenAI-compatible /chat/completions API.
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
#   Claude:  LLM_BASE_URL=https://api.anthropic.com/v1 LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
