# 4.5 AI IVR — copy this file to .env in this folder and fill in the values:
#   cp .env.example .env
# Every script in this tutorial (the relay servers and the .sh helpers) reads
# this .env from the tutorial folder root.

# ── Sinch Voice API v2 credentials (from https://dashboard.sinch.com) ──────────
PROJECT_ID=your-projectid-here
KEY_ID=your-key-here
KEY_SECRET=your-secret-here

# The service whose call behavior configure-service.sh sets (Step 1).
# Find it via GET /v2/projects/{projectId}/services or in the dashboard.
SERVICE_ID=your-service-id-here

# Your Sinch virtual number (E.164). Used as caller-ID when dialing the agent
# and (for test-callout.sh) as the "from" for the simulated inbound call.
SINCH_NUMBER=+1XXXXXXXXXX

# Public wss:// URL of your relay server (the ngrok forwarding URL).
# Must be wss:// — Sinch requires TLS for Voice Relay.
WS_ENDPOINT=wss://your-ngrok-id.ngrok-free.app

# The two human-agent queues the relay can patch the call into (E.164).
SALES_NUMBER=+15558880001
SUPPORT_NUMBER=+15558880002

# Model-agnostic LLM — any OpenAI-compatible /chat/completions API.
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
#   Claude:  LLM_BASE_URL=https://api.anthropic.com/v1 LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Only for test-callout.sh: your own phone (E.164), the simulated "caller".
DESTINATION_NUMBER=+1XXXXXXXXXX

# Optional — port the relay server listens on (default 8765).
# Must match the port you pass to `ngrok http`.
# PORT=8765
